<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeltaText</AssemblyName>
    <PackageId>DeltaText</PackageId>
    <Version>0.0.9</Version>
    <Authors>Artromskiy</Authors>
    <Description>Renderer-neutral text shaping and managed glyph image generation for .NET.</Description>
    <PackageTags>text;shaping;fonts;glyphs;sdf;msdf</PackageTags>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaText</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RootNamespace>Delta.Text</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SixLaborsFontsPackageVersion Condition="'$(SixLaborsFontsPackageVersion)' == ''">3.1.3</SixLaborsFontsPackageVersion>
    <SixLaborsFontsAssemblyPath Condition="'$(SixLaborsFontsAssemblyPath)' == ''">$(NuGetPackageRoot)sixlabors.fonts/$(SixLaborsFontsPackageVersion)/lib/net8.0/SixLabors.Fonts.dll</SixLaborsFontsAssemblyPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeltaMaths" Version="0.0.10" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.Fonts" Version="$(SixLaborsFontsPackageVersion)" PrivateAssets="all" />
    <None Include="$(SixLaborsFontsAssemblyPath)" Pack="true" PackagePath="lib/net8.0/SixLabors.Fonts.dll" Visible="false" Condition="Exists('$(SixLaborsFontsAssemblyPath)')" />
    <None Include="$(MSBuildProjectDirectory)/../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/../../README.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
  </ItemGroup>

  <Target Name="ValidateBundledSixLaborsAssembly" BeforeTargets="Pack">
    <Error Condition="'$(SixLaborsFontsAssemblyPath)' == ''" Text="SixLabors.Fonts must be restored before packing DeltaText." />
    <Error Condition="'$(SixLaborsFontsAssemblyPath)' != '' And !Exists('$(SixLaborsFontsAssemblyPath)')" Text="SixLaborsFontsAssemblyPath does not exist: $(SixLaborsFontsAssemblyPath)" />
  </Target>
</Project>
