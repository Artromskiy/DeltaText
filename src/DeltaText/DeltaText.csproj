<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeltaText</AssemblyName>
    <PackageId>DeltaText</PackageId>
    <Version>0.0.6</Version>
    <Authors>Artromskiy</Authors>
    <Description>Renderer-neutral text shaping and managed glyph image generation for .NET.</Description>
    <PackageTags>text;shaping;fonts;glyphs;sdf;msdf</PackageTags>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaText</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RootNamespace>Delta.Text</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SixLaborsFontsPackageId Condition="'$(SixLaborsFontsPackageId)' == ''">SixLabors.Fonts.Delta</SixLaborsFontsPackageId>
    <SixLaborsFontsPackageVersion Condition="'$(SixLaborsFontsPackageVersion)' == ''">3.1.0</SixLaborsFontsPackageVersion>
    <SixLaborsFontsPackageSource Condition="'$(SixLaborsFontsPackageSource)' == ''">$(MSBuildProjectDirectory)/../../../Furnace/Packages/SixLabors.Fonts-Fork</SixLaborsFontsPackageSource>
    <SixLaborsFontsAssemblyPath Condition="'$(SixLaborsFontsAssemblyPath)' == ''"></SixLaborsFontsAssemblyPath>
    <RestoreSources>$(SixLaborsFontsPackageSource);$(RestoreSources)</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeltaMaths" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="$(SixLaborsFontsPackageId)" Version="$(SixLaborsFontsPackageVersion)" PrivateAssets="all" />
    <None Include="$(SixLaborsFontsAssemblyPath)" Pack="true" PackagePath="lib/net8.0/SixLabors.Fonts.dll" Visible="false" Condition="Exists('$(SixLaborsFontsAssemblyPath)')" />
    <None Include="$(MSBuildProjectDirectory)/../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/../../README.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
  </ItemGroup>

  <Target Name="ValidateBundledSixLaborsAssembly" BeforeTargets="Pack">
    <Error Condition="'$(SixLaborsFontsAssemblyPath)' == ''" Text="SixLaborsFontsAssemblyPath is required when packing DeltaText. Pass the verified fork SixLabors.Fonts.dll explicitly." />
    <Error Condition="'$(SixLaborsFontsAssemblyPath)' != '' And !Exists('$(SixLaborsFontsAssemblyPath)')" Text="SixLaborsFontsAssemblyPath does not exist: $(SixLaborsFontsAssemblyPath)" />
  </Target>
</Project>
