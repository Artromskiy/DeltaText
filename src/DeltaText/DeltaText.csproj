<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DeltaText</AssemblyName>
    <PackageId>DeltaText</PackageId>
    <Version>0.0.6</Version>
    <Authors>Artromskiy</Authors>
    <Description>Renderer-neutral text shaping and managed glyph image generation for .NET.</Description>
    <PackageTags>text;shaping;fonts;glyphs;sdf;msdf</PackageTags>
    <RepositoryUrl>https://github.com/Artromskiy/DeltaText</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RootNamespace>Delta.Text</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <SixLaborsFontsPackageVersion Condition="'$(SixLaborsFontsPackageVersion)' == ''">3.1.0-fork.cadda774</SixLaborsFontsPackageVersion>
    <SixLaborsFontsPackageSource Condition="'$(SixLaborsFontsPackageSource)' == ''">$(MSBuildProjectDirectory)/../../../Furnace/Packages/SixLabors.Fonts-Fork</SixLaborsFontsPackageSource>
    <RestoreSources>$(SixLaborsFontsPackageSource);$(RestoreSources)</RestoreSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeltaMaths" Version="[0.0.7, )" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.Fonts" Version="$(SixLaborsFontsPackageVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(MSBuildProjectDirectory)/../../README.md"
          Pack="true"
          PackagePath="README.md"
          Visible="false" />
  </ItemGroup>
</Project>
